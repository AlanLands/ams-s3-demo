# Provider selection: "anthropic", "bedrock", "openai", "ollama", or "custom". Leave unset
# to auto-detect from the API keys below (auto-detect prefers OpenAI when both
# keys are present, per leadership steer; ollama and bedrock are never
# auto-detected since neither has an API key — set LLM_PROVIDER explicitly).
# Today only the Anthropic key is available, so set this explicitly:
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Claude via Amazon Bedrock — the path for the TCS GenAI AWS environment, where
# outbound access to api.anthropic.com is not available. No API key: credentials
# come from the standard AWS chain, and on the deployed EC2 box that means the
# instance role (so nothing secret lands in this file — hard rule 3).
# AWS_PROFILE is for local development only; leave it unset on the instance.
# Note the `anthropic.` prefix on the model id — the bare first-party id 400s.
# The Bedrock account must have model access granted for this model.
# Set LLM_PROVIDER=bedrock above to actually use this block.
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-sonnet-5

# Local model via Ollama's OpenAI-compatible endpoint (no API key, no external
# network call — useful for an offline rehearsal or a locked-down environment
# with no outbound access at all). Requires `ollama serve` running locally
# with OLLAMA_MODEL already pulled (`ollama pull llama3.1`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Self-hosted / custom LLM  — set LLM_PROVIDER=custom above to use this block.
# ---------------------------------------------------------------------------
# For a sandbox that runs its own models behind an OpenAI-compatible API:
# an internal gateway, vLLM, LiteLLM, TGI, LM Studio, or similar. This is the
# block to fill in when the hosting team says "use our LLM".
#
# CUSTOM_LLM_BASE_URL must be the FULL endpoint root, including the version
# segment your gateway expects — usually ending in /v1. It is used exactly as
# written: nothing is appended or rewritten, so a wrong URL gives you a clean
# 404 instead of a confusing one. The client requests
# <CUSTOM_LLM_BASE_URL>/chat/completions.
#
# CUSTOM_LLM_API_KEY is optional — many self-hosted gateways do no auth. Leave
# it blank and a placeholder is sent, which those gateways ignore.
#
# Examples:
#   CUSTOM_LLM_BASE_URL=https://llm.internal.example/v1
#   CUSTOM_LLM_BASE_URL=http://10.0.0.5:8000/v1        # vLLM default
#   CUSTOM_LLM_BASE_URL=http://localhost:1234/v1       # LM Studio default
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

# LLM response cache (disk) — keeps demo beats deterministic and avoids repeat spend.
LLM_CACHE_DIR=.cache/llm
LLM_NO_CACHE=0

# Default is "replay" (demo-reliability rule in CLAUDE.md: recorded outputs
# are primary, live calls are opt-in, never the reverse). Set to "live" for
# rehearsal recording sessions or ad hoc live testing; "record" additionally
# refreshes the S3 codegen/testgen replay caches used by LLM_MODE=replay.
LLM_MODE=replay

# LLM call telemetry (disk) — written by common/llm.py on every call, read by
# tools/cost_dashboard.py.
LLM_TELEMETRY_PATH=.cache/llm/telemetry.jsonl

# Internal-only: shows a link to tools/cost_dashboard.py in the S1 app sidebar.
# Leave unset/0 for the actual client demo — this is a team tool, not a demo beat.
SHOW_DEV_TOOLS=0
COST_DASHBOARD_URL=http://localhost:8510

# S3 live agent-harness beat (s3_enhancement/harness.py, demo/run_s3_harness.sh).
# AGENT_HARNESS picks which headless coding-agent CLI drives the "money shot"
# codegen beat: "claude" (claude -p) or "codex" (codex exec). Both must be
# installed, on PATH, and pre-authenticated/trusted for this repo before demo
# day — rehearse whichever lands the change more reliably.
AGENT_HARNESS=claude
# demo/run_s3_harness.sh defaults to replaying the rehearsed recording and
# only touches HARNESS_MODE at all when invoked with --live. HARNESS_MODE
# then governs that live run: "record" (default if unset) runs the real CLI
# and refreshes the replay recording; "live" runs it without recording.
# Leave unset for the normal record-on-every-rehearsal behavior.
HARNESS_MODE=
# Wall-clock kill switch for a hung/looping harness run.
HARNESS_TIMEOUT_SECONDS=300

# S2 recurring-cluster detection thresholds (s2_problem/clustering.py). Defaults
# are tuned to this demo's seeded clusters (~600-row corpus, clusters of 12-17
# rows) — retune here, not in code, once real client incident volume is known.
S2_MIN_CLUSTER_SIZE=10
S2_MAX_CLUSTER_SIZE=40
S2_DBSCAN_EPS=0.25
S2_DBSCAN_EPS_VECTOR=0.3
S2_DBSCAN_MIN_SAMPLES=4

# Semantic-retrieval vector store (common/vectorstore.py), used by S1 similar-
# incident/KB retrieval, S2 clustering, S3 file relevance, and S4 talk-to-code.
# "local" (default): Chroma's bundled ONNX MiniLM model, runs fully offline
# after a one-time ~80MB download — no API key, can't fail live on a network
# hiccup. "openai": OpenAI's text-embedding-3-small instead (reuses
# OPENAI_API_KEY above). Run demo/warm_vectorstore.sh once per machine (and
# after any corpus-changing reset) so that download/embed cost never happens
# live during the demo.
EMBEDDING_PROVIDER=local

# S2 problem-ticket creation mode (s2_problem/problem_ticket.py): "true" once the
# client's ServiceNow REST API is confirmed open; unset/false renders a guided
# manual checklist instead. See docs/design/s2_problem_rca.md § The ServiceNow toggle.
SERVICENOW_API_OPEN=false

# S3 "connect your real GitLab" beat (common/gitlab_client.py). Read-only REST
# calls only -- never clones a repo, never writes back. GITLAB_MODE mirrors
# LLM_MODE/HARNESS_MODE: "live" calls the real API; "record" also saves a
# rehearsal recording to s3_enhancement/cache/gitlab_*.json; "replay"
# reproduces that recording offline with zero network calls (demo-day default).
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_MODE=replay

# CR-2026-042's before/after screenshot beat (s3_enhancement/screenshots.py).
# Requires `pip install -r requirements.txt` then a one-time
# `playwright install chromium` per machine (downloads a headless browser —
# not needed at all for the demo-day default, SCREENSHOT_MODE=replay).
# SCREENSHOT_MODE mirrors GITLAB_MODE/HARNESS_MODE/LLM_MODE: "live" launches
# a real headless browser against the running mockapp and returns the PNG
# without saving it; "record" does the same and also saves a rehearsal
# recording to s3_enhancement/cache/screenshots/; "replay" reproduces that
# recording offline with zero browser/network calls (demo-day default).
SCREENSHOT_MODE=replay
# Where the mockapp Streamlit instance is running — only read in live/record
# mode. Includes the Streamlit base path (STREAMLIT_BASE_URL_PATH below);
# keep the two in sync, and mirror any change in the frontend's
# VITE_MOCKAPP_URL (apps/console/web/.env.local).
MOCKAPP_URL=http://localhost:8501/sl_policycore

# Streamlit base path for the PolicyCore portal (apps/run-policycore.sh,
# demo/run_mockapp.sh) so it can live behind a shared reverse proxy —
# http://host:8501/sl_policycore instead of the bare port root. Must match
# the proxy's location block (see deploy/aws/nginx.conf).
STREAMLIT_BASE_URL_PATH=sl_policycore

# ClaimsPortal services (apps/claimsportal). POLICY_SERVICE_URL is what
# Claims-Service dials for policy lookups (claims_service/policy_client.py) —
# repoint it when Policy-Service runs on another host/port. The *_PORT vars
# feed the launchers (apps/run-policy-service.sh, apps/run-claims-service.sh).
POLICY_SERVICE_PORT=8081
CLAIMS_SERVICE_PORT=8082
POLICY_SERVICE_URL=http://localhost:8081

# EnrolDirect (apps/enroldirect). Standalone — seeds its own data and calls no
# other service, so it needs only its own port.
ENROLDIRECT_PORT=8083

# S3 "connect your real Jira" beat (common/jira_client.py). Jira Cloud's
# Free plan (up to 10 users) is enough — create an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens. Writes
# (create_issue, attach_file) are only ever called from a human-confirmed
# button click in the frontend, never automatically. JIRA_MODE mirrors
# GITLAB_MODE/HARNESS_MODE/LLM_MODE: "live" calls the real API; "record"
# also saves a rehearsal recording to s3_enhancement/cache/jira_*.json;
# "replay" reproduces that recording offline with zero network calls
# (demo-day default).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AMS
JIRA_MODE=replay
