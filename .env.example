CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

LLM_MODE=replay

LLM_CACHE_DIR=.cache/llm
LLM_NO_CACHE=0

# --- Application hosting — ports and base paths (see apps/README.md) ---
# The launch scripts under apps/ source this file and fall back to these same
# values, so a plain localhost run needs none of them set. The frontend's own
# VITE_* URLs live in apps/console/web/.env.example and must stay in step.
STREAMLIT_BASE_URL_PATH=sl_policycore
ENROLDIRECT_PORT=8083
DOCUMENTHUB_PORT=8084
# Cross-application URLs. Nothing dials another service by a hard-coded
# address — the pipeline's screenshot step reaches PolicyCore via MOCKAPP_URL.
# Every target app is self-contained at runtime: EnrolDirect and DocumentHub
# each seed their own data in-process and call nothing.
MOCKAPP_URL=http://localhost:8501/sl_policycore

# Browser origins the console API accepts cross-origin requests from, comma
# separated. Only needed when the UI is served from an origin other than the
# API's own — a packaged build is same-origin and never uses this.
CONSOLE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

