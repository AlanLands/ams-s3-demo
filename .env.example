# Provider selection: "anthropic", "openai", or "ollama". Leave unset to
# auto-detect from the API keys below (auto-detect prefers OpenAI when both
# keys are present, per leadership steer; ollama is never auto-detected since
# it has no API key — set LLM_PROVIDER=ollama explicitly to use it).
# Today only the Anthropic key is available, so set this explicitly:
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Local model via Ollama's OpenAI-compatible endpoint (no API key, no external
# network call — useful for an offline rehearsal or a locked-down environment
# with no outbound access at all). Requires `ollama serve` running locally
# with OLLAMA_MODEL already pulled (`ollama pull llama3.1`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LLM response cache (disk) — keeps demo beats deterministic and avoids repeat spend.
LLM_CACHE_DIR=.cache/llm
LLM_NO_CACHE=0

# Default is "replay" (demo-reliability rule in CLAUDE.md: recorded outputs
# are primary, live calls are opt-in, never the reverse). Set to "live" for
# rehearsal recording sessions or ad hoc live testing; "record" additionally
# refreshes the S3 codegen/testgen replay caches used by LLM_MODE=replay.
LLM_MODE=replay

# LLM call telemetry (disk) — written by common/llm.py on every call, read by
# tools/cost_dashboard.py.
LLM_TELEMETRY_PATH=.cache/llm/telemetry.jsonl

# Internal-only: shows a link to tools/cost_dashboard.py in the S1 app sidebar.
# Leave unset/0 for the actual client demo — this is a team tool, not a demo beat.
SHOW_DEV_TOOLS=0
COST_DASHBOARD_URL=http://localhost:8510

# S3 live agent-harness beat (s3_enhancement/harness.py, demo/run_s3_harness.sh).
# AGENT_HARNESS picks which headless coding-agent CLI drives the "money shot"
# codegen beat: "claude" (claude -p) or "codex" (codex exec). Both must be
# installed, on PATH, and pre-authenticated/trusted for this repo before demo
# day — rehearse whichever lands the change more reliably.
AGENT_HARNESS=claude
# demo/run_s3_harness.sh defaults to replaying the rehearsed recording and
# only touches HARNESS_MODE at all when invoked with --live. HARNESS_MODE
# then governs that live run: "record" (default if unset) runs the real CLI
# and refreshes the replay recording; "live" runs it without recording.
# Leave unset for the normal record-on-every-rehearsal behavior.
HARNESS_MODE=
# Wall-clock kill switch for a hung/looping harness run.
HARNESS_TIMEOUT_SECONDS=300

# S2 recurring-cluster detection thresholds (s2_problem/clustering.py). Defaults
# are tuned to this demo's seeded clusters (~600-row corpus, clusters of 12-17
# rows) — retune here, not in code, once real client incident volume is known.
S2_MIN_CLUSTER_SIZE=10
S2_MAX_CLUSTER_SIZE=40
S2_DBSCAN_EPS=0.25
S2_DBSCAN_EPS_VECTOR=0.3
S2_DBSCAN_MIN_SAMPLES=4

# Semantic-retrieval vector store (common/vectorstore.py), used by S1 similar-
# incident/KB retrieval, S2 clustering, S3 file relevance, and S4 talk-to-code.
# "local" (default): Chroma's bundled ONNX MiniLM model, runs fully offline
# after a one-time ~80MB download — no API key, can't fail live on a network
# hiccup. "openai": OpenAI's text-embedding-3-small instead (reuses
# OPENAI_API_KEY above). Run demo/warm_vectorstore.sh once per machine (and
# after any corpus-changing reset) so that download/embed cost never happens
# live during the demo.
EMBEDDING_PROVIDER=local

# S2 problem-ticket creation mode (s2_problem/problem_ticket.py): "true" once the
# client's ServiceNow REST API is confirmed open; unset/false renders a guided
# manual checklist instead. See docs/design/s2_problem_rca.md § The ServiceNow toggle.
SERVICENOW_API_OPEN=false

# S3 "connect your real GitLab" beat (common/gitlab_client.py). Read-only REST
# calls only -- never clones a repo, never writes back. GITLAB_MODE mirrors
# LLM_MODE/HARNESS_MODE: "live" calls the real API; "record" also saves a
# rehearsal recording to s3_enhancement/cache/gitlab_*.json; "replay"
# reproduces that recording offline with zero network calls (demo-day default).
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_MODE=replay
