# AMS console frontend — build-time configuration.
#
# Vite bakes VITE_* values into the bundle at BUILD time, not at run time:
# copy this file to .env.local, edit, then `npm run build` again for a change
# to take effect. Every value below defaults to the previous hard-coded local
# value, so a plain localhost run needs none of them set.
#
# Only VITE_-prefixed names are exposed to the browser — that is a Vite rule,
# and it is also why no secret belongs in this file (hard rule 3).

# Where the FastAPI backend lives (src/api.ts's request() prefixes every call
# with it; trailing slashes are trimmed). Empty = same-origin, which is what
# both the dev proxy and the packaged build want. Set it only when the console
# is served from a different origin/path than the API, e.g.
#   VITE_API_BASE_URL=https://demo.example.com/ams-api
VITE_API_BASE_URL=

# The PolicyCore (MapleSure) Streamlit portal the S3 page links to after a
# change is applied. Includes the Streamlit base path — keep it in step with
# STREAMLIT_BASE_URL_PATH in the repo-root .env.
VITE_MOCKAPP_URL=http://localhost:8501/sl_policycore

# The ClaimsPortal Claims Team console (CR-2026-043's target app), served by
# apps/run-claims-service.sh. Keep the port in step with CLAIMS_SERVICE_PORT
# in the repo-root .env.
VITE_CLAIMS_SERVICE_URL=http://localhost:8082/

# The EnrolDirect console (CR-2026-045's target app), served by
# apps/run-enroldirect.sh. Keep the port in step with ENROLDIRECT_PORT.
VITE_ENROLDIRECT_URL=http://localhost:8083/
