[Unit]
Description=AMS S3 demo — MapleSure policy/claims mockapp (Streamlit, the CR target)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ams-s3-demo
EnvironmentFile=/opt/ams-s3-demo/.env
Environment=PYTHONPATH=/opt/ams-s3-demo
Environment=PYTHONUNBUFFERED=1

# baseUrlPath must match the nginx location block (/sl_policycore/) and
# STREAMLIT_BASE_URL_PATH in .env — without it Streamlit builds absolute asset
# URLs at / and the page loads blank behind the proxy. Hard-coded rather than
# read from the EnvironmentFile above: an unset variable would expand to
# nothing and Streamlit would silently swallow the next flag as the path.
# Bound to localhost; nginx fronts it.
ExecStart=/opt/ams-s3-demo/.venv/bin/streamlit run apps/policycore/app.py \
    --server.port 8501 \
    --server.address 127.0.0.1 \
    --server.baseUrlPath sl_policycore \
    --server.headless true \
    --browser.gatherUsageStats false

Restart=on-failure
RestartSec=5

# Writes the SQLite policy/claims DB inside the tree — same reasoning as the
# console unit, no filesystem hardening here.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
