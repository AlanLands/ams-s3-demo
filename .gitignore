# secrets
.env

# python
__pycache__/
*.pyc
.venv/
venv/
.ruff_cache/
.pytest_cache/
*.egg-info/

# generated data & cache — never hand-edit, regenerate via datagen
.cache/
data/*
!data/.gitkeep
!data/kb_articles
data/kb_articles/*
!data/kb_articles/.gitkeep

# S3 live-codegen per-run staging/diff artifacts — regenerated every run,
# never hand-edited. s3_enhancement/cache/ (the replay safety net) is NOT
# excluded here — that one is a real deliverable, committed for demo reliability.
s3_enhancement/out/

# React frontend — build output/deps regenerate via npm install / npm run build.
# See CLAUDE.md's Working style note: apps/console/web/dist must be built or vendored
# ahead of time for the locked-down-environment port, since npm may not be
# available there.
apps/console/web/node_modules/
apps/console/web/dist/

# OS / editor noise
.DS_Store
*.swp

# local scratch — never demo material
tmp/
output/
.claude-scratch-*

# personal files parked inside the repo dir (move them out when convenient) —
# ignored so a broad `git add` can never sweep multi-GB media into the repo
123/

# local editor config
.vscode/

# reference material with real client name/faces — never commit (hard rule #2)
DemoThatAnotherTeam created/

# Photographs of the client's own Jira/Copilot screens, shared for scoping.
# They carry real employee names, real internal system names and real issue
# keys — hard rules #1 and #2. Read them, de-identify what you take from them,
# never commit them.
scenario/

# Vite's dependency pre-bundling cache. Written wherever a dev server is
# started from, including stale paths — never a source artifact.
.vite/

# PID files and stdout/stderr from deploy/production/start-apps.sh.
logs/

# Client-supplied source material — real call recordings, transcripts and
# stories. Never committed: hard rule 1 (no real client data) and hard rule 2
# (no client names). Drop files here to work with them locally; they stay out
# of the repo.
ScenariosFromClient/
